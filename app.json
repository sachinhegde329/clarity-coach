{
  "expo": {
    "name": "Clarity Coach",
    "slug": "clarity-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F3F0E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.claritycoach.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Clarity Coach to transcribe practice attempts for local speech metrics and coaching feedback."
      }
    },
    "android": {
      "package": "com.claritycoach.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0E8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Clarity Coach to record practice attempts for playback and coaching analysis."
        }
      ],
      "@sentry/react-native/expo"
    ]
  }
}
