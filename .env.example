# Public Expo runtime config. These are safe to ship in the mobile bundle.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-public-key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your-posthog-project-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=https://public@sentry.io/project

# Server-only secrets. Put these in Supabase Edge Function secrets, not in Expo.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=gsk_your-groq-key
OPENAI_API_KEY=sk-your-openai-fallback-key
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
TRANSCRIPTION_PROVIDER=groq
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
SENTRY_AUTH_TOKEN=your-sentry-auth-token-for-source-map-upload
